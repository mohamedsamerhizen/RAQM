  "components": {
    "schemas": {
      "AddMemberRequest": {
        "required": [
          "userId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CompanyRequest": {
        "required": [
          "name",
          "registrationNumber",
          "baseCurrency",
          "fiscalYearStartMonth",
          "fiscalYearStartDay"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "registrationNumber": {
            "type": "string"
          },
          "baseCurrency": {
            "type": "string"
          },
          "fiscalYearStartMonth": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "fiscalYearStartDay": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "CompanyRole": {
        "type": "integer"
      },
      "CreateOrganizationRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "GrantCompanyRequest": {
        "required": [
          "userId",
          "role"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "$ref": "#/components/schemas/CompanyRole"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "OnboardRequest": {
        "required": [
          "email",
          "password",
          "organizationName",
          "onboardingKey"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "organizationName": {
            "type": "string"
          },
          "onboardingKey": {
            "type": "string"
          }
        }
      },
      "RefreshRequest": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "UpdateCompanyRequest": {
        "required": [
          "name",
          "baseCurrency",
          "fiscalYearStartMonth",
          "fiscalYearStartDay",
          "version"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "baseCurrency": {
            "type": "string"
          },
          "fiscalYearStartMonth": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "fiscalYearStartDay": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "version": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  },
  "tags": [
    {
